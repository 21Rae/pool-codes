# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI API Key variables (optional fallback for OpenAI models)
OPENAI_API_KEY=""
OPEN_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Client SDK Credentials
# Used if connecting directly via @supabase/supabase-js
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Paystack Payment Gateway Integration
# PAYSTACK_SECRET_KEY: Used server-side to verify transactions, initialize payments, or handle webhooks. Keep this secure!
PAYSTACK_SECRET_KEY="YOUR_PAYSTACK_SECRET_KEY"

# VITE_PAYSTACK_PUBLIC_KEY: Used client-side in React to initialize the Paystack checkout modal or inline popup.
VITE_PAYSTACK_PUBLIC_KEY="YOUR_PAYSTACK_PUBLIC_KEY"

# N8N Chatbot Webhook URL
# This is used server-side to forward chatbot inputs (e.g. date queries, feedback, questions) to your n8n workflow.
N8N_WEBHOOK_URL="https://primary-production.up.railway.app/webhook/your-workflow-id"

